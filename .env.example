# ── Server (FastAPI) ────────────────────────────────────────────────
# Neon / Postgres connection string. Required by the FastAPI server.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: override where scan artifacts are written on disk (default: output/)
# OUTPUT_ROOT=output

# ── Pipeline API keys (read by stock_analyze from the environment) ──
POLYGON_API_KEY=
TAVILY_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Frontend (Next.js) ──────────────────────────────────────────────
# Copy the frontend value into web/.env.local as NEXT_PUBLIC_API_URL
